# ---- 服务 ----
PORT=8787
HOST=127.0.0.1
# 数据目录（sqlite），默认 ./data
TREND_RADAR_DATA_DIR=./data
# 自动采集间隔（分钟），0 = 只手动
COLLECT_MINUTES=360
# 单源抓取上限 / 条目保留天数
LIMIT_PER_SOURCE=40
# 新闻类 RSS（tags 带 news）单源上限；取 min(LIMIT_PER_SOURCE, 本值)
LIMIT_PER_NEWS_SOURCE=20
TTL_DAYS=180
# 相关度低于此分不入库（0 = 全留）
MIN_KEEP_SCORE=0

# ---- LLM（OpenAI 兼容，用于选题生成 / 自动翻译 / 技术点抽取）----
# 不配置时生成类接口返回 503 llm_not_configured；翻译自动降级不报错。
# 智谱 coding plan 订阅 key 必须用 coding 端点（标准 paas/v4 会报 1113 余额不足）：
# LLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
# LLM_MODEL=glm-5.3-flash
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=glm-5.3-flash
LLM_MAX_TOKENS=8000
# 翻译/抽取批次默认关闭思考模式（GLM-5.3-Flash 实测省 ~90% token）；设 0 恢复思考
TREND_LLM_THINKING_DISABLED=1
# 每日翻译条数上限初始默认值（设置页可改；默认 2000）
TREND_TRANSLATION_DAILY_LIMIT=2000

# ---- 查新（智慧芽 PatSnap CLI）----
# 不配置时 /api/ideas/:id/novelty/auto 返回 503 novelty_not_configured，可手工录入命中数
ZHY_COMMAND=
ZHY_AGREE_KICK=0

# ── 自动中文翻译（t18，设置页可改，这里只是首次默认值）──
# TREND_TRANSLATION_DISABLED=0          # 设 1 时翻译默认关闭
# TREND_TRANSLATION_DAILY_LIMIT=500     # 每日翻译条数上限
