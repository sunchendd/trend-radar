# ---- 服务 ----
PORT=8787
HOST=127.0.0.1
# 数据目录（sqlite），默认 ./data
TREND_RADAR_DATA_DIR=./data
# 自动采集间隔（分钟），0 = 只手动
COLLECT_MINUTES=360
# 单源抓取上限 / 条目保留天数
LIMIT_PER_SOURCE=40
TTL_DAYS=180
# 相关度低于此分不入库（0 = 全留）
MIN_KEEP_SCORE=0

# ---- LLM（OpenAI 兼容，用于生成专利选题）----
# 不配置时 /api/ideas/generate 返回 503 llm_not_configured，界面会提示
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=8000

# ---- 查新（智慧芽 PatSnap CLI）----
# 不配置时 /api/ideas/:id/novelty/auto 返回 503 novelty_not_configured，可手工录入命中数
ZHY_COMMAND=
ZHY_AGREE_KICK=0
