{
  "name": "@trend-radar/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "trend-radar": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts serve",
    "start": "node dist/index.js serve",
    "collect": "tsx src/index.ts collect",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^8.1.1",
    "fastify": "^5.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "pino-pretty": "^13.0.0"
  }
}
